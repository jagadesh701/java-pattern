1. ALPHABET PATTERN:

public class alphabetpattern {
    public static void main(String[] args) {
        int n = 4;
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n - i; j++) {
                System.out.print(" ");
            }
            for (char k = 'A'; k < 'A' + i; k++) {
                System.out.print(k + " ");
            }
            System.out.println();
        }
    }
    
}
OUTPUT:
   A 
  A B   
 A B C  
A B C D 

