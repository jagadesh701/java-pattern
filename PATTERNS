2. INVERTED HOLLOW PATTERN:

public class invertedhollow {
    public static void main(String[] args) {
        int n = 6;
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j < i; j++) {
                System.out.print(" ");
            }
            for (int k = i; k <= 6; k++) {
                if (i == 1 || k == i || k == 6) {
                    System.out.print("* ");
                } else {
                    System.out.print("  ");
                }
            }
            System.out.println();
        }
    }
}

OUTPUT:
* * * * * * 
 *       *  
  *     *   
   *   *    
    * *     
     *

