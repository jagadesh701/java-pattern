4.  NUMBER TRIANGLE PATTERN:

public class numbertriangle {
    public static void main(String[] args) {
        int num = 1;
        for (int i = 1; i <= 4; i++) {
            for (int j = i; j <= 4; j++) {
                System.out.print(" " );
      }
            for (int k = 1; k <=(1*i); k++) {
                System.out.print( num + " ");
                num++;
            }
            System.out.println();
        }
